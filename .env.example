# ============================================================
# Multi-Agent Medical Triage Assistant - Environment Variables
# Copy this file to `.env` and fill in your keys.
# ============================================================

# --- Google Gemini (REQUIRED) ---------------------------------
# Get a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults shown):
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- ElevenLabs (OPTIONAL - speech input/output) ---------------
# https://elevenlabs.io  |  https://elevenlabs.io/app/api-keys
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# --- Tavily (OPTIONAL - web search agent) ----------------------
# https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- HuggingFace (OPTIONAL - model downloads) ------------------
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# --- Optional reranking (requires torch + sentence-transformers) -
# Set to "true" only after installing: pip install sentence-transformers torch
ENABLE_RERANKER=false

# --- Supabase Cloud Database Integration (REAL CLOUD DATABASE) ---
# https://supabase.com
USE_SUPABASE=true
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_POSTGRES_URI=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres