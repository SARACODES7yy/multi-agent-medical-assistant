# ============================================================
# Multi-Agent Medical Triage Assistant - Environment Variables
# Copy this file to `.env` and fill in your keys.
# ============================================================

# --- Google Gemini (REQUIRED) ---------------------------------
# Get a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults shown):
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Groq (Primary fallback/LLM option) ------------------------
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192

# --- OpenRouter (Universal LLM fallback) -----------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MAX_TOKENS=8192

# --- ElevenLabs (OPTIONAL - speech input/output) ---------------
# https://elevenlabs.io  |  https://elevenlabs.io/app/api-keys
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here

# --- Cloudflare Workers AI (FALLBACK/OPTIONAL) ---------------
# Get API token with "Workers AI Read" and Account ID from Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_MAX_TOKENS=8192
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# --- HuggingFace (OPTIONAL - model downloads) ------------------
# https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# --- Optional reranking (requires torch + sentence-transformers) -
# Set to "true" only after installing: pip install sentence-transformers torch
ENABLE_RERANKER=false

# --- LLM Providers (all available) ----------------------------
# Available providers: gemini, groq, openrouter, cloudflare
# Priority order used by llm(): groq → openrouter → cloudflare → gemini
# Fallbacks are automatic if higher-priority provider fails.
FALLBACK_PROVIDERS=groq,openrouter,cloudflare,gemini
TEXT_FALLBACK_PROVIDERS=groq,openrouter,cloudflare,gemini
VISION_FALLBACK_PROVIDERS=gemini,openrouter,cloudflare,groq
ENABLE_LLM_FALLBACK=true

# --- Supabase Cloud Database Integration (REAL CLOUD DATABASE) ---
# https://supabase.com
USE_SUPABASE=true
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_POSTGRES_URI=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres